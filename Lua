-- ============================================================
-- SKIN CHANGERS (runtime population)
-- ============================================================
if Cap.require and Appearance and Appearance.MapGunSkin then
    local knifeList, gloveList = {}, {}
    for _, wep in ipairs(RS.Weapons:GetChildren()) do
        if wep:GetAttribute('WeaponType')=='Melee' then table.insert(knifeList,wep.Name) end
    end
    for _, gl in ipairs(RS.Gloves:GetChildren()) do table.insert(gloveList,gl.Name) end

    -- Weapon skins
    for _, folder in ipairs(RS.Skins:GetChildren()) do
        if not folder:IsA('Folder') then continue end
        if table.find(knifeList,folder.Name) or table.find(gloveList,folder.Name) then continue end
        local skins={}
        for _, sub in ipairs(folder:GetChildren()) do
            if sub:IsA('Folder') then table.insert(skins,sub.Name) end
        end
        if #skins==0 then continue end
        local displayName=(RS.Weapons:FindFirstChild(folder.Name)
            and RS.Weapons[folder.Name]:GetAttribute('DisplayName')) or folder.Name
        local skinEnabled=false local skinSelected=skins[1]
        SkinsBox:AddToggle("Skin_"..folder.Name,{
            Text=displayName, Default=false,
            Callback=function(v)
                skinEnabled=v
                if v then
                    local arms=Camera:FindFirstChild('Arms')
                    if isAlive(LP) and arms then
                        pcall(function()
                            Appearance.MapGunSkin(arms,folder.Name..'_'..skinSelected,false,0,false,LP,EquippedWeaponFolder,nil)
                            LP.Character:SetAttribute('WhatSkin',folder.Name..'_'..skinSelected)
                        end)
                    end
                end
            end,
        })
        SkinsBox:AddDropdown("SkinDrop_"..folder.Name,{
            Text="Skin",Values=skins,Default=skins[1],
            Callback=function(v)
                skinSelected=v
                if skinEnabled then
                    local arms=Camera:FindFirstChild('Arms')
                    if isAlive(LP) and arms then
                        pcall(function()
                            Appearance.MapGunSkin(arms,folder.Name..'_'..v,false,0,false,LP,EquippedWeaponFolder,nil)
                        end)
                    end
                end
            end,
        })
    end

    -- Knife changer
    local currentKnife = knifeList[1] or "Knife"
    KnifeBox:AddToggle("KnifeEnabled",{Text="Enabled",Default=false})
    KnifeBox:AddDropdown("KnifeSel",{
        Text="Knife", Values=knifeList, Default=currentKnife,
        Callback=function(v) currentKnife=v end,
    })
    -- Apply knife on change
    RunService.Heartbeat:Connect(function()
        if not Toggles.KnifeEnabled.Value then return end
        if not isAlive(LP) then return end
        if not EquippedWeapon or not table.find(knifeList,EquippedWeapon) then return end
        pcall(function()
            LP:SetAttribute('KnifeType',currentKnife)
            LP:SetAttribute('KnifeSkin',currentKnife..'_Stock')
            local arms=Camera:FindFirstChild('Arms')
            if arms then Appearance.MapGunSkin(arms,currentKnife..'_Stock',false,0,false,LP,EquippedWeaponFolder,nil) end
        end)
    end)

    -- Gloves
    local currentGlove = gloveList[1] or "Glove"
    local function applyGloves()
        if not isAlive(LP) then return end
        local g = currentGlove..'_Stock'
        LP:SetAttribute('CTGloves',g) LP:SetAttribute('TGloves',g)
        if LP.Character then
            LP.Character:SetAttribute('CTGloves',g) LP.Character:SetAttribute('TGloves',g)
        end
    end
    GloveBox:AddToggle("GloveEnabled",{
        Text="Enabled", Default=false,
        Callback=function(v)
            if v then applyGloves()
            else
                LP:SetAttribute('CTGloves','Glove_Stock') LP:SetAttribute('TGloves','Glove_Stock')
                if LP.Character then
                    LP.Character:SetAttribute('CTGloves','Glove_Stock')
                    LP.Character:SetAttribute('TGloves','Glove_Stock')
                end
            end
        end,
    })
    GloveBox:AddDropdown("GloveSel",{
        Text="Gloves", Values=gloveList, Default=currentGlove,
        Callback=function(v) currentGlove=v if Toggles.GloveEnabled.Value then applyGloves() end end,
    })
else
    SkinsBox:AddLabel("Skin Changer: require unsupported")
    KnifeBox:AddLabel("Knife Changer: require unsupported")
    GloveBox:AddLabel("Gloves Changer: require unsupported")
end

