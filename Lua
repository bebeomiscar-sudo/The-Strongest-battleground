        local fireRate  = Toggles.RagebotRapidFire.Value and 0.01
            or (EquippedWeaponFolder:GetAttribute('FireRate') or 0.1)
        local now = tick()
        if (now - RagebotLastShot) < math.max(interval, fireRate) then continue end

