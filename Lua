        end
        if #hitscanList == 0 then hitscanList = {"Head"} end

        -- Fallback radius config
        local fallbackRadius = Options.RBFallbackRadius.Value
        local randomFactor   = Options.RBFallbackRandom.Value / 100
        local actualRadius   = fallbackRadius * (1 + (math.random()*2-1) * randomFactor)

        -- Depth oscillation values
        local t         = now
        local duMin     = Options.RBDepthUpMin.Value  * 0.1
        local duMax     = Options.RBDepthUpMax.Value  * 0.1
        local duFreq    = Options.RBDepthUpFreq.Value * 0.1
        local dfMin     = Options.RBDepthFwdMin.Value * 0.1
        local dfMax     = Options.RBDepthFwdMax.Value * 0.1
        local dfFreq    = Options.RBDepthFwdFreq.Value * 0.1
        local depthUp   = duMin + (duMax-duMin) * (0.5 + 0.5*math.sin(t*duFreq*math.pi*2))
        local depthFwd  = dfMin + (dfMax-dfMin) * (0.5 + 0.5*math.sin(t*dfFreq*math.pi*2))

        local myTeam = LP:GetAttribute('Team')
        local fired  = false

        for _, player in ipairs(Players:GetPlayers()) do
            if fired then break end
            if player == LP then continue end
            if not RS:GetAttribute('NoTKPenalty')
            and player:GetAttribute('Team') == myTeam then continue end
            if not isAlive(player) then continue end
            if player.Character:FindFirstChildWhichIsA('ForceField') then continue end

            local char = player.Character
            local hrp  = char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end

            -- FOV / fallback radius check
            if Toggles.RagebotUseFOV.Value then
                local fovPx = (Camera.ViewportSize.X * ((Options.RagebotFOVValue.Value/2) / Camera.FieldOfView)) / 2
                local sp, on = W2S(hrp.Position)
                if not on then continue end

                if Toggles.RBFallbackFromChar.Value then
                    local myHRP = LP.Character:FindFirstChild("HumanoidRootPart")
                    local wdist = myHRP and (myHRP.Position - hrp.Position).Magnitude or math.huge
                    if wdist > actualRadius then continue end
                else
                    if distFromCenter(sp) > math.max(fovPx, actualRadius) then continue end
                end
            end

            local parts = GetHitboxes(char, hitscanList)
            if #parts == 0 then continue end

            local hitPart = parts[1]
            local partName = (Toggles.RagebotForceHead.Value or hitPart.Name:find('Head'))
                and 'Head' or hitPart.Name

            -- Apply depth offsets
            local hitPos = hitPart.Position
                + Vector3.new(0, depthUp, 0)
                + Camera.CFrame.LookVector * depthFwd

            local taps = Toggles.RagebotDoubleTap.Value and 2 or 1
            local hps  = math.max(1, Options.RagebotHPS.Value)

            if Toggles.RagebotSimShoot and Toggles.RagebotSimShoot.Value then
                task.spawn(FakeShoot, EquippedWeaponFolder, false)
            end

            for _ = 1, hps do
                for _ = 1, taps do
                    pcall(function()
                        Shucky.activateresult(
                            {{ Hit=hitPart, Position=hitPos, Normal=Vector3.new(0,1,0) }},
                            EquippedWeaponFolder,
                            myHead.Position,
                            false, nil, nil, nil
                        )
                    end)
                end
            end

            if Toggles.RagebotDebug.Value then
                Library:Notify(("Shot %s [%s] d:%.1f"):format(player.Name, partName, depthUp), 2)
            end

            RagebotLastShot = tick()
            fired = true
        end
    end
end)

