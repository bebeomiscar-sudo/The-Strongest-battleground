-- AIMBOT
-- ============================================================
RunService.RenderStepped:Connect(function()
    if not Toggles.AimbotEnabled.Value then return end
    if RS:GetAttribute('Preparation') or RS:GetAttribute('RoundOver') then return end

    local partName  = Options.AimbotHitscan.Value or "Head"
    local fov       = Options.AimbotFOV.Value
    local smooth    = Options.AimbotSmooth.Value
    local visCheck  = Toggles.AimbotVisCheck.Value
    local teamCheck = Options.AimbotTeam.Value == "Enemies Only"
    local useFOV    = Toggles.AimbotUseFOV.Value
    local pred      = Options.AimbotPrediction.Value * 0.01
    local aimType   = Options.AimbotType.Value

    local target = getBestTarget(fov, partName, visCheck, teamCheck, useFOV)
    if not target then return end

    local char = target.Character
    local part = char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart")
    if not part then return end

    local hrp      = char:FindFirstChild("HumanoidRootPart")
    local aimPos   = part.Position
    if pred > 0 and hrp then
        aimPos = part.Position + hrp.AssemblyLinearVelocity * pred
    end

    if aimType == "Mouse Movement" and typeof(mousemoverel) == "function" then
        local sp = Camera:WorldToViewportPoint(aimPos)
        local dx = (sp.X - Camera.ViewportSize.X / 2) * (smooth / 9) / 20.5
        local dy = (sp.Y - Camera.ViewportSize.Y / 2) * (smooth / 9) / 20.5
        mousemoverel(dx, dy)
    elseif aimType == "Lerp" then
        local targetCF = CFrame.new(Camera.CFrame.Position, aimPos)
        local angle = math.max(0.001, math.abs(math.deg(math.acos(math.clamp(
            Camera.CFrame.LookVector:Dot(CFrame.new(Camera.CFrame.Position, aimPos).LookVector),
            -1, 1)))))
        local alpha = Options.AimbotSpeedType.Value == "Exponential"
            and smooth / 500
            or (smooth / angle) / 100
        Camera.CFrame = Camera.CFrame:Lerp(targetCF, alpha)
    else
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPos)
    end
end)

