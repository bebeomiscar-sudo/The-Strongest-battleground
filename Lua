-- ============================================================
-- CHAMS  (Highlight on Combatant-tagged characters)
-- Uses Roblox Highlight instance — no per-part material hack
-- More stable and no FPS cost
-- ============================================================
local _highlights = {}

RunService.Heartbeat:Connect(function()
    local enabled   = Toggles.ChamsEnabled.Value
    local teamCheck = Toggles.ChamsTeamCheck.Value
    local visCol    = Options.ChamsVisColor.Value
    local hidCol    = Options.ChamsHidColor.Value

    -- Build active set
    local activeSet = {}
    if enabled then
        for _, char in ipairs(getCombatants()) do
            if teamCheck and not isEnemy(char) then continue end
            activeSet[char] = true
        end
    end

    -- Remove stale highlights
    for char, hl in pairs(_highlights) do
        if not activeSet[char] then
            pcall(function() hl:Destroy() end)
            _highlights[char] = nil
        end
    end

    -- Add / update highlights
    for char in pairs(activeSet) do
        if not _highlights[char] then
            local hl = Instance.new("Highlight")
            hl.DepthMode          = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillColor          = hidCol
            hl.OutlineColor       = visCol
            hl.FillTransparency   = 0.5
            hl.OutlineTransparency = 0
            hl.Adornee            = char
            hl.Parent             = char
            _highlights[char]     = hl
        else
            -- Update colors based on visibility
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local vis = hrp and isVisible(char, hrp)
            _highlights[char].FillColor    = vis and visCol or hidCol
            _highlights[char].OutlineColor = vis and visCol or hidCol
        end
    end
end)

