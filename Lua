-- From doc 6 (MatchCameraController) — characters tagged "Combatant"
local function getCombatants()
    local list = {}
    for _, model in ipairs(CollectionService:GetTagged("Combatant")) do
        if model:IsA("Model") and model ~= LP.Character then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local hrp = model:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp and hrp:IsA("BasePart") then
                table.insert(list, model)
            end
        end
    end
    return list
end

-- From doc 7 (KillEffectController) — SpawnImmuneUntil attribute check
local function isSpawnImmune(char)
    local val = char:GetAttribute("SpawnImmuneUntil")
    return typeof(val) == "number" and val - Workspace:GetServerTimeNow() > 0
end

local function getPlayer(char)
    return Players:GetPlayerFromCharacter(char)
end

local function isAlive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isEnemy(char)
    local plr = getPlayer(char)
    if not plr then return false end
    if plr == LP then return false end
    -- Check team via attribute (common in FPS games)
    local myTeam    = LP:GetAttribute("Team") or LP.Team
    local theirTeam = plr:GetAttribute("Team") or plr.Team
    if myTeam and theirTeam then return myTeam ~= theirTeam end
    return true
end

local function getPart(char, partName)
    return char:FindFirstChild(partName)
        or char:FindFirstChild("HumanoidRootPart")
end

local function screenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function toScreen(pos)
    local sp, onScr = Camera:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), onScr, sp.Z
end

local function distFromCenter(pos2d)
    return (pos2d - screenCenter()).Magnitude
end

local function isVisible(char, part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local dir    = part.Position - origin
    local rp     = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { LP.Character, Camera }
    local hit = Workspace:Raycast(origin, dir, rp)
    if not hit then return true end
    return hit.Instance and hit.Instance:IsDescendantOf(char)
end

-- ============================================================
-- TARGET RESOLVER  (uses CollectionService "Combatant" tag)
-- ============================================================
local function getBestTarget(fovRadius, partName, visCheck, teamCheck)
    local best, bestDist = nil, math.huge
    for _, char in ipairs(getCombatants()) do
        if teamCheck and not isEnemy(char) then continue end
        local part = getPart(char, partName)
        if not part then continue end
        local pos2d, onScr = toScreen(part.Position)
        if not onScr then continue end
        local d = distFromCenter(pos2d)
        if d > fovRadius then continue end
        if visCheck and not isVisible(char, part) then continue end
        if d < bestDist then bestDist = d; best = char end
    end
    return best
end

