        { Vector2.new(cx, cy + gap),      Vector2.new(cx, cy + gap + sz) },
        { Vector2.new(cx - gap, cy),      Vector2.new(cx - gap - sz, cy) },
        { Vector2.new(cx + gap, cy),      Vector2.new(cx + gap + sz, cy) },
    }
    for i, ln in ipairs(xhLines) do
        ln.Visible = on; ln.Thickness = th; ln.Color = col
        if on then ln.From = offs[i][1]; ln.To = offs[i][2] end
    end
end)

