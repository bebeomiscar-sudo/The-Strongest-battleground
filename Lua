local espObjs  = {}
local chamsHLs = {}

local function clearESP(player)
    if not espObjs[player] then return end
    for _, d in pairs(espObjs[player]) do pcall(function() d:Remove() end) end
    espObjs[player] = nil
    if chamsHLs[player] then
        pcall(function() chamsHLs[player]:Destroy() end)
        chamsHLs[player] = nil
    end
end

local function makeESPObj()
    local function L(col,th)
        local l=Drawing.new("Line") l.Thickness=th or 1 l.Color=col l.Visible=false l.Transparency=1 return l
    end
    local function T(sz,col)
        local t=Drawing.new("Text") t.Size=sz t.Center=true t.Outline=true t.Visible=false t.Color=col t.Font=1 return t
    end
    local d = {}
    for i=1,4 do d["b"..i]=L(Color3.new(1,1,1)) end
    d.name  = T(13,Color3.new(1,1,1))
    d.hpBg  = L(Color3.fromRGB(30,30,30),4)
    d.hpFg  = L(Color3.new(0,1,0),4)
    d.dist  = T(11,Color3.fromRGB(220,220,220))
    d.weap  = T(11,Color3.fromRGB(255,200,80))
    d.hpNum = T(11,Color3.new(1,1,1))
    d.trace = L(Color3.new(1,0,0))
    for i=1,8 do d["sk"..i]=L(Color3.new(1,1,1)) end
    return d
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        if Toggles.ESPTeamCheck.Value and not isEnemy(player) then clearESP(player) continue end
        if not Toggles.ESPEnabled.Value or not isAlive(player) then clearESP(player) continue end
        if not espObjs[player] then espObjs[player] = makeESPObj() end

        local char = player.Character
        local hrp  = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not hrp or not head then clearESP(player) continue end

        local hum   = char:FindFirstChildOfClass("Humanoid")
        local hp    = hum and hum.Health or 0
        local maxHp = hum and hum.MaxHealth or 100
        local d     = espObjs[player]
        local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local dist  = myHRP and math.floor((myHRP.Position-hrp.Position).Magnitude) or 0
        if dist > Options.ESPMaxDist.Value then clearESP(player) continue end

        local _, on, depth = W2S(hrp.Position)
        if not on or depth < 0 then clearESP(player) continue end

        local top  = hrp.Position + Vector3.new(0, 3.2,0)
        local bot  = hrp.Position - Vector3.new(0, 3.2,0)
        local rv   = hrp.CFrame.RightVector * 1.3
        local tL   = W2S(top - rv)
        local tR   = W2S(top + rv)
        local bL   = W2S(bot - rv)
        local bR   = W2S(bot + rv)
        local bCol = Options.ESPBoxColor.Value
        local font = Options.ESPTextFont.Value=="Plex" and 1
            or Options.ESPTextFont.Value=="System" and 2
            or Options.ESPTextFont.Value=="Monospace" and 3 or 4
        local sz   = Options.ESPTextSize.Value
        local cx   = tL.X + (tR.X-tL.X)*0.5

        -- Box
        if Toggles.ESPBox.Value then
            d.b1.From=tL d.b1.To=tR d.b1.Color=bCol d.b1.Visible=true
            d.b2.From=bL d.b2.To=bR d.b2.Color=bCol d.b2.Visible=true
            d.b3.From=tL d.b3.To=bL d.b3.Color=bCol d.b3.Visible=true
            d.b4.From=tR d.b4.To=bR d.b4.Color=bCol d.b4.Visible=true
        else for i=1,4 do d["b"..i].Visible=false end end

        -- Name
        if Toggles.ESPName.Value then
            d.name.Text=player.DisplayName d.name.Position=Vector2.new(cx,tL.Y-15)
            d.name.Color=Options.ESPNameColor.Value d.name.Font=font d.name.Size=sz d.name.Visible=true
        else d.name.Visible=false end

        -- HP bar
        if Toggles.ESPHealth.Value then
            local pct = math.clamp(hp/maxHp,0,1)
            local bX  = tL.X - 5
            d.hpBg.From=Vector2.new(bX,tL.Y) d.hpBg.To=Vector2.new(bX,bL.Y) d.hpBg.Visible=true
            d.hpFg.From=Vector2.new(bX,bL.Y)
            d.hpFg.To=Vector2.new(bX,bL.Y-(bL.Y-tL.Y)*pct)
            d.hpFg.Color=Options.ESPHPLow.Value:Lerp(Options.ESPHPFull.Value,pct)
            d.hpFg.Visible=true
        else d.hpBg.Visible=false d.hpFg.Visible=false end

        local yOff = bL.Y + 2
        -- HP number
        if Toggles.ESPHealthNum.Value then
            d.hpNum.Text=math.floor(hp).."/"..math.floor(maxHp)
            d.hpNum.Position=Vector2.new(cx,yOff) d.hpNum.Font=font d.hpNum.Size=sz-2 d.hpNum.Visible=true
            yOff = yOff + 12
        else d.hpNum.Visible=false end

        -- Distance
        if Toggles.ESPDistance.Value then
            d.dist.Text=dist.."m" d.dist.Position=Vector2.new(cx,yOff)
            d.dist.Color=Options.ESPDistColor.Value d.dist.Font=font d.dist.Size=sz-2 d.dist.Visible=true
            yOff = yOff + 12
        else d.dist.Visible=false end

        -- Weapon
        if Toggles.ESPWeapon.Value then
            local gun = player.Character and player.Character:GetAttribute("WhatGun") or "?"
            d.weap.Text=gun d.weap.Position=Vector2.new(cx,yOff)
            d.weap.Color=Options.ESPWeapColor.Value d.weap.Font=font d.weap.Size=sz-2 d.weap.Visible=true
        else d.weap.Visible=false end

        -- Tracer
        if Toggles.ESPTracer.Value then
            d.trace.From=Vector2.new(Camera.ViewportSize.X*0.5,Camera.ViewportSize.Y)
            d.trace.To=W2S(hrp.Position) d.trace.Color=bCol d.trace.Visible=true
        else d.trace.Visible=false end

        -- Skeleton
        if Toggles.ESPSkeleton.Value then
            local bones = {
                {1,"Head","UpperTorso"},{2,"UpperTorso","LowerTorso"},
                {3,"LowerTorso","LeftUpperLeg"},{4,"LowerTorso","RightUpperLeg"},
                {5,"UpperTorso","LeftUpperArm"},{6,"UpperTorso","RightUpperArm"},
                {7,"LeftUpperLeg","LeftLowerLeg"},{8,"RightUpperLeg","RightLowerLeg"},
            }
            for _, b in ipairs(bones) do
                local p1=char:FindFirstChild(b[2]) local p2=char:FindFirstChild(b[3])
                if p1 and p2 then
                    d["sk"..b[1]].From=W2S(p1.Position) d["sk"..b[1]].To=W2S(p2.Position) d["sk"..b[1]].Visible=true
                else d["sk"..b[1]].Visible=false end
            end
        else for i=1,8 do d["sk"..i].Visible=false end end

        -- Chams via Highlight
        if Toggles.ESPChams.Value then
            if not chamsHLs[player] then
                local hl=Instance.new("Highlight") hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                hl.Adornee=char hl.Parent=char chamsHLs[player]=hl
            end
            chamsHLs[player].OutlineColor=Options.ESPChamsVis.Value
            chamsHLs[player].OutlineTransparency=Options.ESPChamsVis.Alpha
            chamsHLs[player].FillColor=Options.ESPChamsInvis.Value
            chamsHLs[player].FillTransparency=Options.ESPChamsInvis.Alpha
        else
            if chamsHLs[player] then chamsHLs[player]:Destroy() chamsHLs[player]=nil end
        end
    end
end

