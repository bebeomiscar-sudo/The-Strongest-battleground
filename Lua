local function SpawnTracer(endPos,sCol,eCol,life,texName)
    local arms = Camera:FindFirstChild('Arms')
    if not arms then return end
    local flash = arms:FindFirstChild('Flash')
    if not flash then return end
    local muzzle = flash.CFrame.Position
    local p0=MakeTempPart(muzzle) local p1=MakeTempPart(endPos)
    local beam=Instance.new('Beam')
    beam.Texture = TracerTextures[texName] or TracerTextures.Line
    local a0=Instance.new('Attachment',p0) local a1=Instance.new('Attachment',p1)
    beam.Attachment0=a0 beam.Attachment1=a1
    beam.Color=ColorSequence.new{ColorSequenceKeypoint.new(0,sCol),ColorSequenceKeypoint.new(1,eCol)}
    beam.Width0=0.2 beam.Width1=0.2 beam.FaceCamera=true
    beam.Transparency=NumberSequence.new(0) beam.Parent=Workspace.Debris
    task.spawn(function()
        task.wait(life)
        for i=1,10 do beam.Transparency=NumberSequence.new(i/10) task.wait(0.05) end
        beam:Destroy() a0:Destroy() a1:Destroy()
    end)
end

local function SpawnImpact(pos,col,life)
    if not EquippedWeaponFolder then return end
    if EquippedWeaponFolder:GetAttribute('WeaponType')=='Melee' then return end
    local p=Instance.new('Part')
    p.Transparency=1 p.Anchored=true p.CanCollide=false p.Size=Vector3.new(0.3,0.3,0.3) p.Position=pos
    local sb=Instance.new('SelectionBox',p)
    sb.LineThickness=0 sb.SurfaceTransparency=0.5 sb.Color3=col sb.SurfaceColor3=col sb.Adornee=p
    p.Parent=Workspace.Debris
    task.spawn(function() task.wait(life) sb:Destroy() p:Destroy() end)
end

if Cap.hookmetamethod and Cap.hookfunction and Cap.getrawmetatable then
    local mt  = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args   = { ... }

        if method == "FireServer" and FireEvent and self == FireEvent then
            if args[1] and type(args[1])=="table" and args[1].Position then
                local hitPos = args[1].Position
                if Toggles.WBulletTracers.Value then
                    task.spawn(SpawnTracer, hitPos,
                        Options.WTracerStart.Value, Options.WTracerEnd.Value,
                        Options.WTracerLifetime.Value, Options.WTracerTexture.Value)
                end
                if Toggles.WHitImpacts.Value then
                    task.spawn(SpawnImpact, hitPos,
                        Options.WHitImpactColor.Value, Options.WHitImpactLife.Value)
                end
            end
            -- Throwable teleport
            if Toggles.TeleportThrowable and Toggles.TeleportThrowable.Value then
                local target = getBestTarget(math.huge,"Head",false,true,false)
                if target and target.Character then
                    local th = target.Character:FindFirstChild("Head")
                    if th then
                        args[2] = th.CFrame args[3] = -100
                        return old(self, table.unpack(args))
                    end
                end
            end
        end

        -- Viewmodel arm offset / no sway
        if method == "PivotTo" and self.Parent == Camera and self.Name == "Arms" then
            if Toggles.VMEnabled.Value then
                args[1] = args[1] * CFrame.new(
                    Options.VMX.Value/300, Options.VMY.Value/300, Options.VMZ.Value/300)
                return old(self, table.unpack(args))
            end
            if Toggles.ArmsNoSway and Toggles.ArmsNoSway.Value then
                if not (Toggles.ThirdPerson.Value) then
                    args[1] = Camera.CFrame
                    return old(self, table.unpack(args))
                end
            end
        end

        return old(self, ...)
    end)

    -- Arms bob via __index
    local oldIndex = mt.__index
    mt.__index = newcclosure(function(obj, key)
        if Cap.checkcaller and not checkcaller() then
            local char = LP.Character
            if key == 'Velocity' and char and obj.Parent == char then
                if Toggles.ArmsNoBob and Toggles.ArmsNoBob.Value and isAlive(LP) then
                    return Vector3.zero
                end
            end
        end
        return oldIndex(obj, key)
    end)

    setreadonly(mt, true)
end

