-- ============================================================
-- FIRE EVENT RESOLVER
-- ============================================================
local FireEvent

local function GetFireEvent()
    if Shucky and Shucky.activateresult
    and debug and debug.getupvalue and setthreadidentity then
        local id = getthreadidentity()
        setthreadidentity(2)
        local t  = debug.getupvalue(Shucky.activateresult, 5)
        local ev = t()
        setthreadidentity(id)
        return ev
    end
    local function nameFromSeed(seed)
        local t, chars = math.max(1, math.floor(seed) % 2147483647), {}
        for i = 1, 24 do
            t = t * 48271 % 2147483647
            local w = t % 62 + 1
            chars[i] = string.sub(
                'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789',
                w, w)
        end
        return 'sus_' .. table.concat(chars)
    end
    local sauce = RS:GetAttribute('AmongUsSauce')
    while typeof(sauce) ~= 'number' do
        RS:GetAttributeChangedSignal('AmongUsSauce'):Wait()
        sauce = RS:GetAttribute('AmongUsSauce')
    end
    return RS:WaitForChild('Events'):WaitForChild(nameFromSeed(sauce))
end

pcall(function() FireEvent = GetFireEvent() end)
RS:GetAttributeChangedSignal('AmongUsSauce'):Connect(function()
    pcall(function() FireEvent = GetFireEvent() end)
end)

