local function isAlive(player)
    return player.Character
        and player.Character:FindFirstChild('Head')
        and player.Character:FindFirstChild('HumanoidRootPart')
        and player.Character:FindFirstChild('Humanoid')
        and player:GetAttribute('Health')
        and player:GetAttribute('Health') > 0
        and player:GetAttribute('Team') ~= 'Spectator'
        and player:GetAttribute('Alive')
end

local function isEnemy(player)
    if player == LP then return false end
    if RS:GetAttribute('NoTKPenalty') then return true end
    local myTeam    = LP:GetAttribute('Team')
    local theirTeam = player:GetAttribute('Team')
    if myTeam and theirTeam then return myTeam ~= theirTeam end
    return true
end

local function W2S(pos)
    local sp, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on, sp.Z
end

local function getCenter()
    return Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
end

local function distFromCenter(pos2d)
    return (pos2d - getCenter()).Magnitude
end

local function isVisible(char, part)
    if not char or not part then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character, Camera }
    local dir    = part.Position - Camera.CFrame.Position
    local result = Workspace:Raycast(Camera.CFrame.Position, dir, params)
    if not result then return true end
    return result.Instance and result.Instance:IsDescendantOf(char)
end

