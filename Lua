-- ============================================================
-- AIMBOT
-- ============================================================
RunService.RenderStepped:Connect(function()
    if not Toggles.AimbotEnabled.Value then setAiming(false) return end
    if Toggles.AimbotOnAim.Value and not _isAiming then return end

    local partName  = Options.AimbotPart.Value
    local fov       = Options.AimbotFOV.Value
    local smooth    = Options.AimbotSmooth.Value
    local visCheck  = Toggles.AimbotVisCheck.Value
    local pred      = Options.AimbotPred.Value

    local target = getBestTarget(fov, partName, visCheck, true)
    if not target then setAiming(false) return end

    local part = getPart(target, partName)
    if not part then setAiming(false) return end

    -- velocity prediction
    local hrp = target:FindFirstChild("HumanoidRootPart")
    local aimPos = part.Position
    if pred > 0 and hrp then
        aimPos = aimPos + hrp.AssemblyLinearVelocity * pred
    end

    local dir      = (aimPos - Camera.CFrame.Position).Unit
    local targetCF = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + dir)
    Camera.CFrame  = Camera.CFrame:Lerp(targetCF, 1 / smooth)

    setAiming(true)
end)

-- ============================================================
-- SILENT AIM  + TRIGGERBOT
-- Hooks FireShot:FireServer via __namecall metamethod
-- FireShot args: [1]=mode [2]=origin [3]=direction [4]=timestamp [6]=seed
-- ============================================================
local _triggerCooldown = false

if hookmetamethod then
    local mt  = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args   = { ... }

        -- ---- Silent Aim ----
        if method == "FireServer" and self == _FireShotRemote
            and Toggles.SilentEnabled.Value then

            local partName  = Options.SilentPart.Value
            local fov       = Options.SilentFOV.Value
            local visCheck  = Toggles.SilentVisCheck.Value
            local teamCheck = Toggles.SilentTeamCheck.Value
            local chance    = Options.SilentChance.Value

            if math.random(1, 100) <= chance then
                local target = getBestTarget(fov, partName, visCheck, teamCheck)
                if target then
                    local part = getPart(target, partName)
                    if part then
                        -- Redirect direction (arg[3]) to target part
                        local origin = typeof(args[2]) == "Vector3"
                            and args[2]
                            or Camera.CFrame.Position
                        local newDir = (part.Position - origin).Unit
                        args[3] = newDir
                        return old(self, table.unpack(args))
                    end
                end
            end
        end

        -- ---- Track aiming state from real SetAiming calls ----
        if method == "FireServer" and self == _SetAimingRemote then
            if typeof(args[1]) == "boolean" then
                _isAiming = args[1]
            end
        end

        return old(self, ...)
    end)

    setreadonly(mt, true)
else
    Library:Notify("hookmetamethod unavailable — Silent Aim disabled", 5)
end

-- ---- Triggerbot (uses CollectionService "Combatant" tag raycast) ----
RunService.RenderStepped:Connect(function()
    if not Toggles.TriggerEnabled.Value then return end
    if _triggerCooldown then return end

    local visCheck  = Toggles.TriggerVisCheck.Value
    local teamCheck = Toggles.TriggerTeamCheck.Value

    local origin = Camera.CFrame.Position
    local dir    = Camera.CFrame.LookVector * 2000

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { LP.Character, Camera }

    local result = Workspace:Raycast(origin, dir, rp)
    if not result or not result.Instance then return end

    -- Find the character by checking Combatant tag
    local hitInst = result.Instance
    local hitChar = hitInst:FindFirstAncestorOfClass("Model")
    if not hitChar then return end
    if not CollectionService:HasTag(hitChar, "Combatant") then return end
    if not isAlive(hitChar) then return end
    if teamCheck and not isEnemy(hitChar) then return end
    if visCheck and not isVisible(hitChar, hitInst) then return end

    _triggerCooldown = true
    local delay = Options.TriggerDelay.Value / 1000

    task.delay(delay, function()
        if not _FireShotRemote then _triggerCooldown = false return end
        -- Fire with exact arg signature from dex
        local origin2  = Camera.CFrame.Position
        local dir2     = Camera.CFrame.LookVector
        local mode     = Options.AimFireMode.Value
        local ts       = tick() * 1000  -- timestamp matching game's format
        pcall(function()
            _FireShotRemote:FireServer(mode, origin2, dir2, ts, nil, 185)
        end)
        task.wait(0.05)
        _triggerCooldown = false
    end)
end)

-- ============================================================
-- RAGEBOT  (full-send: instant FireShot spam at nearest target)
-- Uses CollectionService:GetTagged("Combatant")
-- ============================================================
local _rageLastShot = 0
local _RAGE_RATE    = 1 / 20  -- 20 shots/sec max

RunService.RenderStepped:Connect(function()
    if not Toggles.RageEnabled.Value then return end
    local now = tick()
    if now - _rageLastShot < _RAGE_RATE then return end

    local partName = Options.RageHitscan.Value
    local fov      = Options.RageFOV.Value
    local useF     = Toggles.RageFOVEnabled.Value
    local visChk   = Toggles.RageVisCheck.Value

    local target = getBestTarget(useF and fov or math.huge, partName, visChk, true)
    if not target then return end

    local part = getPart(target, partName)
    if not part then return end

    if not Toggles.RageSilent.Value then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
    end

    if not _FireShotRemote then return end

    local origin = Camera.CFrame.Position
    local dir    = (part.Position - origin).Unit
    local delay  = Options.RageDelay.Value / 1000
    local mode   = Options.AimFireMode.Value
    local ts     = now * 1000

    task.delay(delay, function()
        pcall(function()
            _FireShotRemote:FireServer(mode, origin, dir, ts, nil, 185)
        end)
    end)
    _rageLastShot = now
end)

