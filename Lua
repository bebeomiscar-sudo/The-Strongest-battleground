-- ESP  (from CollectionService:GetTagged("Combatant"))
-- SpawnImmuneUntil from BulletHoleController analysis
-- ============================================================
local espObjects = {}

local function clearESP(char)
    if espObjects[char] then
        for _, d in pairs(espObjects[char]) do
            pcall(function() d:Remove() end)
        end
        espObjects[char] = nil
    end
end

local function makeESP(char)
    clearESP(char)
    local d = {}

    -- 4-line box
    for i = 1, 4 do
        local l = Drawing.new("Line")
        l.Thickness = 1; l.Color = Options.ESPBoxColor.Value
        l.Visible = false; l.Transparency = 1
        d["box"..i] = l
    end

    -- Name
    local nm = Drawing.new("Text")
    nm.Size = 13; nm.Center = true; nm.Outline = true
    nm.Visible = false; nm.Color = Color3.fromRGB(255,255,255)
    d.name = nm

    -- Health bar bg + fill
    local hBg = Drawing.new("Line")
    hBg.Thickness = 4; hBg.Color = Color3.fromRGB(20,20,20)
    hBg.Visible = false; hBg.Transparency = 1
    d.hBg = hBg

    local hFill = Drawing.new("Line")
    hFill.Thickness = 4; hFill.Visible = false; hFill.Transparency = 1
    d.hFill = hFill

    -- Distance
    local dist = Drawing.new("Text")
    dist.Size = 11; dist.Center = true; dist.Outline = true
    dist.Visible = false; dist.Color = Color3.fromRGB(200,200,200)
    d.dist = dist

    -- Weapon label
    local wep = Drawing.new("Text")
    wep.Size = 11; wep.Center = true; wep.Outline = true
    wep.Visible = false; wep.Color = Color3.fromRGB(255,200,80)
    d.wep = wep

    -- Spawn immune indicator
    local si = Drawing.new("Text")
    si.Size = 11; si.Center = true; si.Outline = true
    si.Visible = false; si.Color = Color3.fromRGB(255,255,80)
    si.Text = "IMMUNE"
    d.spawnImm = si

    -- Tracer
    local tr = Drawing.new("Line")
    tr.Thickness = 1; tr.Visible = false; tr.Transparency = 1
    d.tracer = tr

    -- Skeleton (8 bones)
    for i = 1, 8 do
        local b = Drawing.new("Line")
        b.Thickness = 1; b.Color = Color3.fromRGB(255,255,255)
        b.Visible = false; b.Transparency = 1
        d["bone"..i] = b
    end

    espObjects[char] = d
end

local function updateESP()
    local enabled = Toggles.ESPEnabled.Value

    -- Build set of active combatant chars
    local activeCombatants = {}
    for _, char in ipairs(getCombatants()) do
        activeCombatants[char] = true
    end

    -- Remove stale ESP
    for char in pairs(espObjects) do
        if not activeCombatants[char] then clearESP(char) end
    end

    if not enabled then
        for char in pairs(espObjects) do clearESP(char) end
        return
    end

    for char in pairs(activeCombatants) do
        local teamCheck = Toggles.ESPTeamCheck.Value
        if teamCheck and not isEnemy(char) then clearESP(char); continue end

        if not espObjects[char] then makeESP(char) end
        local d   = espObjects[char]
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not hrp or not head then clearESP(char); continue end

        local hum    = char:FindFirstChildOfClass("Humanoid")
        local hp     = hum and hum.Health    or 0
        local maxHp  = hum and hum.MaxHealth or 100

        -- Box corners
        local topPos = hrp.Position + Vector3.new(0, 2.8, 0)
        local botPos = hrp.Position + Vector3.new(0, -2.8, 0)
        local cf     = hrp.CFrame

        local tL, onScr = toScreen(topPos + cf.RightVector * -1.1)
        local tR        = toScreen(topPos + cf.RightVector *  1.1)
        local bL        = toScreen(botPos + cf.RightVector * -1.1)
        local bR        = toScreen(botPos + cf.RightVector *  1.1)

        local _, onScrHRP, depth = toScreen(hrp.Position)
        if not onScrHRP or depth < 0 then clearESP(char); continue end

        local plrRef = getPlayer(char)
        local myHRP  = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local distVal = myHRP and math.floor((myHRP.Position - hrp.Position).Magnitude) or 0
        if distVal > Options.ESPMaxDist.Value then clearESP(char); continue end

        local boxCol = Options.ESPBoxColor.Value

        -- Box
        if Toggles.ESPBox.Value then
            d.box1.From = tL; d.box1.To = tR; d.box1.Color = boxCol; d.box1.Visible = true
            d.box2.From = bL; d.box2.To = bR; d.box2.Color = boxCol; d.box2.Visible = true
            d.box3.From = tL; d.box3.To = bL; d.box3.Color = boxCol; d.box3.Visible = true
            d.box4.From = tR; d.box4.To = bR; d.box4.Color = boxCol; d.box4.Visible = true
        else for i=1,4 do d["box"..i].Visible = false end end

        -- Name
        if Toggles.ESPName.Value then
            local dispName = plrRef and plrRef.DisplayName or char.Name
            d.name.Text     = dispName
            d.name.Position = Vector2.new(tL.X + (tR.X - tL.X)/2, tL.Y - 16)
            d.name.Visible  = true
        else d.name.Visible = false end

        -- Health bar
        if Toggles.ESPHealth.Value then
            local pct  = math.clamp(hp / maxHp, 0, 1)
            local barX = tL.X - 5
            local barH = bL.Y - tL.Y
            d.hBg.From    = Vector2.new(barX, tL.Y)
            d.hBg.To      = Vector2.new(barX, bL.Y)
            d.hBg.Visible = true
            d.hFill.From  = Vector2.new(barX, bL.Y)
            d.hFill.To    = Vector2.new(barX, bL.Y - barH * pct)
            d.hFill.Color = Color3.new(1 - pct, pct, 0)
            d.hFill.Visible = true
        else d.hBg.Visible = false; d.hFill.Visible = false end

        -- Distance
        if Toggles.ESPDist.Value then
            d.dist.Text     = distVal .. "m"
            d.dist.Position = Vector2.new(bL.X + (bR.X - bL.X)/2, bL.Y + 2)
            d.dist.Visible  = true
        else d.dist.Visible = false end

        -- Weapon (WhatGun / equipped weapon attribute — common FPS pattern)
        if Toggles.ESPWeapon.Value then
            local gunAttr = char:GetAttribute("EquippedWeapon")
                         or char:GetAttribute("WhatGun")
                         or char:GetAttribute("CurrentWeapon")
                         or "?"
            d.wep.Text     = tostring(gunAttr)
            d.wep.Position = Vector2.new(bL.X + (bR.X - bL.X)/2, bL.Y + 14)
            d.wep.Visible  = true
        else d.wep.Visible = false end

        -- Spawn immune indicator (from BulletHoleController — SpawnImmuneUntil)
        if Toggles.ESPSpawnImm.Value and isSpawnImmune(char) then
            d.spawnImm.Position = Vector2.new(tL.X + (tR.X - tL.X)/2, tL.Y - 28)
            d.spawnImm.Visible  = true
        else d.spawnImm.Visible = false end

        -- Tracer
        if Toggles.ESPTracer.Value then
            local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            local feet   = toscreen and toScreen(botPos) or bL
            d.tracer.From    = center
            d.tracer.To      = bL
            d.tracer.Color   = boxCol
            d.tracer.Visible = true
        else d.tracer.Visible = false end

        -- Skeleton (standard R6/R15 bones)
        if Toggles.ESPSkeleton.Value then
            local function bone(idx, a, b)
                local pA = char:FindFirstChild(a)
                local pB = char:FindFirstChild(b)
                if pA and pB then
                    local s = toScreen(pA.Position)
                    local e = toScreen(pB.Position)
                    d["bone"..idx].From = s; d["bone"..idx].To = e
                    d["bone"..idx].Visible = true
                else d["bone"..idx].Visible = false end
            end
            bone(1, "Head",         "UpperTorso")
            bone(2, "UpperTorso",   "LowerTorso")
            bone(3, "LowerTorso",   "LeftUpperLeg")
            bone(4, "LowerTorso",   "RightUpperLeg")
            bone(5, "UpperTorso",   "LeftUpperArm")
            bone(6, "UpperTorso",   "RightUpperArm")
            bone(7, "LeftUpperLeg", "LeftLowerLeg")
            bone(8, "RightUpperLeg","RightLowerLeg")
        else for i=1,8 do d["bone"..i].Visible = false end end
    end
end

