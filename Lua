-- ============================================================
-- WEAPON INFO  (from WeaponController — DataController:GetData())
-- ============================================================
local _DataController, _WeaponLib, _WeaponProg

pcall(function()
    _DataController = require(ReplicatedStorage.Controllers.DataController)
end)
pcall(function()
    _WeaponLib  = require(ReplicatedStorage.SharedModules.Libraries.Weapons)
end)
pcall(function()
    _WeaponProg = require(ReplicatedStorage.SharedModules.WeaponProgression)
end)

local function getWeaponInfo()
    if not _DataController then return nil end
    local ok, data = pcall(function() return _DataController:GetData() end)
    if not ok or not data then return nil end
    return data.Weapons
end

local function getWeaponLevel(weaponName)
    if not _WeaponProg or not _WeaponLib then return 0 end
    local wepData = getWeaponInfo()
    if not wepData or not wepData[weaponName] then return 0 end
    local exp = wepData[weaponName].Experience or 0
    return pcall(function() return _WeaponProg.ExperienceToLevel(exp) end) and _WeaponProg.ExperienceToLevel(exp) or 0
end

local function getEquippedWeaponName()
    local char = LP.Character
    if not char then return nil end
    -- Common attribute names for equipped weapon in FPS games
    return char:GetAttribute("EquippedWeapon")
        or char:GetAttribute("CurrentWeapon")
        or char:GetAttribute("WhatGun")
end

RunService.Heartbeat:Connect(function()
    if not Toggles.WeaponInfoEnabled.Value then return end
    local wepName = getEquippedWeaponName()
    if not wepName then return end

    local lvl = getWeaponLevel(wepName)
    local wepInfo = getWeaponInfo()
    local amt = wepInfo and wepInfo[wepName] and wepInfo[wepName].Amount or "?"

    if Library.Labels then
        pcall(function()
            Library.Labels.WepNameLabel:SetText("Weapon: " .. wepName)
            Library.Labels.WepLevelLabel:SetText("Level: " .. tostring(lvl))
            Library.Labels.WepAmountLabel:SetText("Owned: " .. tostring(amt))
        end)
    end
end)

