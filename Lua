local edgeBugPrev   = Enum.HumanoidStateType.None
local edgeBugActive = false

RunService.Heartbeat:Connect(function()
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    -- Bypass speed (jumping state)
    if Toggles.BypassSpeed and Toggles.BypassSpeed.Value and Variables then
        Variables.jumping = (Variables.crouch or Variables.fullycrouched) and true or false
    end

    -- Bunny Hop
    if Toggles.BunnyHop.Value and UserInput:IsKeyDown(Enum.KeyCode.Space) then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
    -- Auto Jump
    if Toggles.AutoJump.Value and UserInput:IsKeyDown(Enum.KeyCode.Space)
    and hum.FloorMaterial ~= Enum.Material.Air then
        hum.Jump = true
    end
    -- Noclip
    if Toggles.Noclip.Value then
        for _, p in ipairs(char:GetChildren()) do
            if p:IsA("BasePart") and p.CanCollide then p.CanCollide=false end
        end
    else
        hrp.CanCollide = true
    end
    -- Speed Hack
    if Toggles.SpeedHack.Value then
        local speed = Options.SpeedHackVal.Value / 10
        local mv    = Vector3.new()
        local camCF = Camera.CFrame
        if UserInput:IsKeyDown(Enum.KeyCode.W) then mv=mv+camCF.LookVector  end
        if UserInput:IsKeyDown(Enum.KeyCode.S) then mv=mv-camCF.LookVector  end
        if UserInput:IsKeyDown(Enum.KeyCode.A) then mv=mv-camCF.RightVector end
        if UserInput:IsKeyDown(Enum.KeyCode.D) then mv=mv+camCF.RightVector end
        if mv.Magnitude>0 then
            mv=Vector3.new(mv.Unit.X,0,mv.Unit.Z)*speed*1.5
            hrp.CFrame=hrp.CFrame+(mv/100*2)
        end
    end
    -- Airstuck
    hrp.Anchored = Toggles.Airstuck.Value
    -- Walk/Jump
    hum.WalkSpeed = Options.WalkSpeed.Value
    hum.JumpPower = Options.JumpPower.Value
    -- Auto Join Team
    if Toggles.AutoJoinTeam.Value then
        local ct = Options.AutoJoinTeamSel.Value == 'Operators'
        pcall(function() RS.RE_Deploy:FireServer(ct) end)
    end
    -- Anti-Spectate
    if isAlive(LP) and Toggles.AntiSpectate.Value then
        local at  = Options.AntiSpectateType.Value
        local pos = at=='Freeze' and Vector3.new(9e9,9e9,9e9) or Camera.CFrame.Position
        local dir = (Camera.CFrame*CFrame.new(0,0,-1)).Position - pos
        local buf = buffer.create(36)
        buffer.writef32(buf,0,pos.X) buffer.writef32(buf,4,pos.Y) buffer.writef32(buf,8,pos.Z)
        buffer.writeu8(buf,12,(dir.X+1)*0.5*255//1)
        buffer.writeu8(buf,13,(dir.Y+1)*0.5*255//1)
        buffer.writeu8(buf,14,(dir.Z+1)*0.5*255//1)
        buffer.writeu8(buf,15,bit32.bor(0,0,0,8))
        buffer.writef32(buf,16,0) buffer.writef32(buf,20,at=='Low Fov' and 0 or 70)
        buffer.writef32(buf,24,0) buffer.writef32(buf,28,0) buffer.writef32(buf,32,0)
        pcall(function() RS.UpdateSpectate:FireServer(buf) end)
    end
    -- Edgebug
    if Toggles.Edgebug.Value and not edgeBugActive then
        local state = hum:GetState()
        if edgeBugPrev==Enum.HumanoidStateType.Freefall and state==Enum.HumanoidStateType.Landed then
            edgeBugActive=true
            local vel=hrp.Velocity
            for _=1,5 do task.wait() hrp.Velocity=(Vector3.new(1.2,0,1.2)*vel)-Vector3.new(0,15,0) end
            task.wait()
            hrp.Velocity=hrp.Velocity*Vector3.new(1.8,1,1.8)
            if Toggles.EdgebugNotif.Value then Library:Notify("Edgebugged!",2) end
            task.delay(Options.EdgebugDebounce.Value*0.01,function() edgeBugActive=false end)
        end
        edgeBugPrev=state
    end
    -- Chat spam
    if Toggles.ChatSpam and Toggles.ChatSpam.Value and Network then
        local t=tick()
        if t-lastChatSpam>3 then
            lastChatSpam=t
            local mt=Options.ChatSpamType.Value
            local msg = mt=='Neyrone'   and string.rep('\n',15)..'neyrone on top '..math.random(1,5)
                     or mt=='Advertise' and string.rep('\n',15)..'tg - neyrone_tech '..math.random(1,5)
                     or mt=='Japanese'  and string.rep('\u{7684}\u{662f}\u{4e0d}\n',16)..math.random(1,5)
                     or (Options.ChatSpamCustom and Options.ChatSpamCustom.Value or "")
            pcall(function() Network.FireServer('Chat',msg,false) end)
        end
    end
end)

