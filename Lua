local throwStore = {}

local function initThrowESP(obj)
    if throwStore[obj] then return end
    if not obj:GetAttribute('Weapon') then return end
    if not obj:FindFirstChildOfClass('MeshPart') then return end
    if obj:GetAttribute('Team')==LP:GetAttribute('Team') then return end

    throwStore[obj] = {}
    local lbl=Drawing.new('Text')
    lbl.Font=2 lbl.Visible=false lbl.Text=obj:GetAttribute('Weapon')
    lbl.Size=13 lbl.Center=true lbl.Outline=true lbl.Color=Color3.new(1,1,1)
    throwStore[obj].lbl=lbl

    throwStore[obj].conn=RunService.PreRender:Connect(function()
        if not obj or not obj.Parent then
            if throwStore[obj] then
                if throwStore[obj].conn then throwStore[obj].conn:Disconnect() end
                if throwStore[obj].lbl  then throwStore[obj].lbl:Remove() end
                throwStore[obj]=nil
            end
            return
        end
        local mesh = obj:FindFirstChildOfClass('MeshPart')
        if not mesh then return end

        if Toggles.ThrowESPChams.Value then
            local hl=mesh:FindFirstChild('_thl') or Instance.new('Highlight',mesh)
            hl.Name='_thl'
            hl.FillColor=Options.ThrowESPFill.Value hl.FillTransparency=Options.ThrowESPFill.Alpha
            hl.OutlineColor=Options.ThrowESPOutline.Value hl.OutlineTransparency=Options.ThrowESPOutline.Alpha
        else
            local hl=mesh:FindFirstChild('_thl') if hl then hl:Destroy() end
        end

        if Toggles.ThrowESPName.Value then
            local sp,on=W2S(obj.Position)
            if on then
                lbl.Text=obj:GetAttribute('Weapon') lbl.Position=Vector2.new(sp.X,sp.Y-20)
                lbl.Color=Options.ThrowESPNameColor.Value lbl.Visible=true
            else lbl.Visible=false end
        else lbl.Visible=false end
    end)
end

Workspace.Debris.ChildAdded:Connect(function(c) task.wait(0.1) initThrowESP(c) end)
Workspace.Destroyable.ChildAdded:Connect(function(c) task.wait(0.1) initThrowESP(c) end)
for _, c in ipairs(Workspace.Debris:GetChildren())      do initThrowESP(c) end
for _, c in ipairs(Workspace.Destroyable:GetChildren()) do initThrowESP(c) end

