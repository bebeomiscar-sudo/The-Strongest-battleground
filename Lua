RunService.PreRender:Connect(function()
    -- Ambient
    if Toggles.WAmbient.Value then
        Lighting.Ambient        = Options.WAmbientColor.Value
        Lighting.OutdoorAmbient = Options.WOutdoorAmbient.Value
    end
    -- No smoke
    if Toggles.WNoSmoke.Value then
        for _, obj in ipairs(CollectionService:GetTagged('Smoke')) do
            pcall(function() obj:Destroy() end)
        end
    end
    -- Time changer
    if Toggles.WTimeChanger.Value then Lighting.ClockTime = Options.WTime.Value end
    -- Skybox
    if Toggles.WSkybox.Value then
        local sel = Options.WSkyboxType.Value
        if sel ~= "--" and Skyboxes[sel] then
            local sky = Lighting:FindFirstChild('Skyboxzz')
                or Instance.new('Sky', Lighting)
            sky.Name = 'Skyboxzz'
            for k,v in pairs(Skyboxes[sel]) do sky[k]=v end
        end
    else
        local sky = Lighting:FindFirstChild('Skyboxzz')
        if sky then sky:Destroy() end
    end
    -- Gun mods
    ApplyGunMods()
    -- Weapon visuals
    if isAlive(LP) and EquippedWeaponFolder then
        local arms = Camera:FindFirstChild('Arms')
        if arms then
            if Toggles.ArmsNoJumpBob.Value then
                pcall(function() arms:SetAttribute('Scale',0) end)
            end
            if Toggles.WepChams.Value then
                for _, part in ipairs(arms:GetDescendants()) do
                    if part:IsA('MeshPart') or part:IsA('UnionOperation') then
                        part.Color=Options.WepChamsColor.Value
                        part.Material=Enum.Material.ForceField
                        part.Transparency=Options.WepChamsColor.Alpha/100
                    end
                end
            end
            if Toggles.WepTexture.Value then
                local texId=WeaponTextures[Options.WepTextureSel.Value]
                if texId then
                    for _, part in ipairs(arms:GetDescendants()) do
                        if part:IsA('MeshPart') then part.TextureID=texId end
                    end
                end
            end
        end
    end
    -- Sound effects
    pcall(function()
        if Toggles.HitSoundEnabled.Value and SoundIds[Options.HitSoundSel.Value] then
            RS.Sounds.HitSound.Value        = SoundIds[Options.HitSoundSel.Value]
            RS.Sounds.HitSound.Volume.Value = Options.HitSoundVol.Value
        else
            RS.Sounds.HitSound.Value        = SoundIds['Default Hit Sound']
        end
        if Toggles.KillSoundEnabled.Value and SoundIds[Options.KillSoundSel.Value] then
            RS.Sounds.KillSound.Value        = SoundIds[Options.KillSoundSel.Value]
            RS.Sounds.KillSound.Volume.Value = Options.KillSoundVol.Value
        else
            RS.Sounds.KillSound.Value        = SoundIds['Default Kill Sound']
        end
    end)
    -- Third person
    if isAlive(LP) then
        local arms = Camera:FindFirstChild('Arms')
        if Toggles.ThirdPerson.Value then
            LP.CameraMode = 'Classic'
            LP.CameraMaxZoomDistance = Options.ThirdPersonDist.Value
            LP.CameraMinZoomDistance = Options.ThirdPersonDist.Value
            if arms then pcall(function() arms:SetAttribute('COffset',CFrame.new(99,99,99)) end) end
        else
            LP.CameraMode = 'LockFirstPerson'
            LP.CameraMaxZoomDistance = 0.5
            LP.CameraMinZoomDistance = 0.5
            if arms then pcall(function() arms:SetAttribute('COffset',CFrame.new(0,0,0)) end) end
        end
    end
end)

