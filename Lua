local function MakeTempPart(pos)
    local p=Instance.new('Part')
    p.Name='_hbt' p.Size=Vector3.new(0.2,0.2,0.2) p.Position=pos
    p.Transparency=1 p.CanCollide=false p.Anchored=true p.Parent=Workspace.Debris
