local function ApplyGunMods()
    for _, wep in ipairs(RS.Weapons:GetChildren()) do
        if not wep:IsA('Folder') then continue end
        local def = defaultWeaponAttribs[wep.Name]
        if not def then continue end

        if Toggles.GMNoRecoil.Value then
            wep:SetAttribute('RecoilX',0) wep:SetAttribute('RecoilY',0)
        else
            wep:SetAttribute('RecoilX',def.RecoilX) wep:SetAttribute('RecoilY',def.RecoilY)
        end
        if Toggles.GMNoSpread.Value then
            for _, a in ipairs({'Spread','CrouchSpread','FireSpread','MoveSpread','JumpSpread','LadderSpread','LandSpread','StandSpread','RunSpread'}) do
                wep:SetAttribute(a, 0)
            end
        else
            for _, a in ipairs({'Spread','CrouchSpread','FireSpread','MoveSpread','JumpSpread','LadderSpread','LandSpread','StandSpread','RunSpread'}) do
                wep:SetAttribute(a, def[a])
            end
        end
        wep:SetAttribute('Auto', Toggles.GMFullAuto.Value and true or def.Auto)
        if Toggles.GMRapidFire.Value then
            wep:SetAttribute('FireRate',0.01) wep:SetAttribute('ScopedFireRate',0.01)
        else
            wep:SetAttribute('FireRate',def.FireRate) wep:SetAttribute('ScopedFireRate',def.ScopedFireRate)
        end
        if Toggles.GMConvAmmo.Value then
            wep:SetAttribute('Ammo',9e9) wep:SetAttribute('StoredAmmo',9e9)
        else
            wep:SetAttribute('Ammo',def.Ammo) wep:SetAttribute('StoredAmmo',def.StoredAmmo)
        end
        if Toggles.GMInfAmmo.Value then
            wep:SetAttribute('UseAmmo',0)
        else
            if wep:GetAttribute('UseAmmo') ~= nil then wep:SetAttribute('UseAmmo',nil) end
        end
    end
end

