-- ============================================================
local function getBestTarget(fov, partName, visCheck, teamCheck, useFOV)
    local best, bestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        if teamCheck and not isEnemy(player) then continue end
        if not isAlive(player) then continue end
        local char = player.Character
        local part = char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        local pos2d, onScreen = W2S(part.Position)
        if not onScreen then continue end
        local dist = distFromCenter(pos2d)
        if useFOV and dist > fov then continue end
        if visCheck and not isVisible(char, part) then continue end
        if dist < bestDist then bestDist = dist best = player end
    end
    return best
end

